import os ;
import feature : feature ;

BOOST_ROOT = [ os.environ BOOST_ROOT ] ;
ECHO "BOOST_ROOT = "$(BOOST_ROOT) ;
if ! $(BOOST_ROOT)
{
	EXIT "You need to define BOOST_ROOT" ;
}

OPENSSL_ROOT = [ os.environ OPENSSL_ROOT ] ;
ECHO "OPENSSL_ROOT = "$(OPENSSL_ROOT) ;
if ! $(OPENSSL_ROOT)
{
	EXIT "You need to define OPENSSL_ROOT" ;
}

LIBTORRENT_ROOT = [ os.environ LIBTORRENT_ROOT ] ;
ECHO "LIBTORRENT_ROOT = "$(LIBTORRENT_ROOT) ;
if ! $(LIBTORRENT_ROOT)
{
	EXIT "You need to define LIBTORRENT_ROOT" ;
}

use-project /torrent : $(LIBTORRENT_ROOT) ;

rule libtorrent_linking ( properties * )
{
    local result ;

    result += <deprecated-functions>off ;
    result += <logging>on ;
    result += <crypto>openssl ;
    result += <webtorrent>on ;
    result += <optimization>speed ;
    result += <cxxstd>17 ;

    result += <library>/torrent//torrent/<link>static ;

    return $(result) ;
}

# the git revision of the libtorrent submodule, baked into the library and
# reported by libtorrent_ext.nativeBuild(); the build scripts set it. b2 does
# not rebuild ext_jni.cpp when only this changes: an incremental build after
# moving the submodule reports the old revision, which then differs from
# LibTorrent.expectedNativeBuild() (it cannot match by accident). A clean
# build, as release/publish.sh does, bakes the current one.
LT4J_LIBTORRENT_REVISION = [ os.environ LT4J_LIBTORRENT_REVISION ] ;
if $(LT4J_LIBTORRENT_REVISION)
{
    ECHO "LT4J_LIBTORRENT_REVISION = "$(LT4J_LIBTORRENT_REVISION) ;
}

feature iostream : off on : composite propagated link-incompatible ;
feature.compose <iostream>off : <define>BOOST_NO_IOSTREAM ;

feature ssl : on off : composite propagated link-incompatible ;
feature.compose <ssl>on :
    <openssl-include>$(OPENSSL_ROOT)/include
    <openssl-lib>$(OPENSSL_ROOT)/lib
    ;

lib torrent4j

    : # sources
	 libtorrent_jni.cpp
	 ext_jni.cpp

    : # requirements
    <conditional>@libtorrent_linking
    <include>.
    <define>LT4J_LIBTORRENT_REVISION=\\\"$(LT4J_LIBTORRENT_REVISION:E=unknown)\\\"

    : # default build
    <link>shared

    : # usage-requirements
    <include>.
    ;
